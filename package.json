{
  "name": "quarks-and-qubits",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Astro + MDX + Tailwind site with CI gates (build, lint, links, axe, Lighthouse, Playwright).",
  "engines": {
    "node": ">=24.16.0 <25"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && node scripts/generate-csp-hashes.js && node scripts/generate-cv-pdf.js",
    "build:fresh": "pnpm browser-data:update && pnpm build",
    "build:check": "pnpm typecheck && pnpm build",
    "build:check:fresh": "pnpm browser-data:update && pnpm build:check",
    "check": "pnpm format:check && pnpm lint && pnpm cspell && pnpm test:unit && pnpm build:check && pnpm html:validate && node scripts/validate-bibtex.js && pnpm security:check && node scripts/validate-sitemap.js",
    "typecheck": "astro check",
    "preview": "node scripts/serve-dist.js",
    "ci:serve": "node scripts/serve-dist.js",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cspell": "cspell --no-progress --no-must-find-files --config cspell.json \"{src,public,scripts,tests}/**/*.{ts,tsx,js,jsx,astro,md,mdx,css,json,yml,yaml}\"",
    "html:validate": "html-validate --config .htmlvalidate.json \"dist/**/*.html\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "lighthouse": "node scripts/run-lighthouse-ci.js",
    "prepare": "husky",
    "browser-data:update": "node scripts/update-browser-data.js",
    "cv:extract": "node scripts/extract-cv-from-docx.js",
    "cv:generate": "node scripts/generate-content-from-cv.js",
    "cv:sync": "pnpm cv:extract && pnpm cv:generate && node scripts/fetch-bibtex.js",
    "bib:fetch": "node scripts/fetch-bibtex.js",
    "test:unit": "node --test tests/*.test.js",
    "security:check": "node scripts/validate-security-headers.js && node scripts/validate-site.js",
    "a11y": "node scripts/run-axe-scan.js",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "astro": "^7.4.4",
    "katex": "^0.19.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "astro-eslint-parser": "^3.0.0",
    "autoprefixer": "^10.6.2",
    "baseline-browser-mapping": "^2.11.34",
    "caniuse-lite": "^1.0.30001820",
    "cspell": "^8.19.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.0.0",
    "html-validate": "^11.18.0",
    "husky": "^9.1.7",
    "lighthouse": "^13.6.0",
    "lint-staged": "^15.5.2",
    "mammoth": "^1.13.0",
    "parse5": "^8.1.0",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "update-browserslist-db": "^1.3.4",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,css,md,mdx,json,yml,yaml}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "@swc/core"
    ],
    "overrides": {
      "minimatch@>=9 <11": "^11.0.3",
      "glob@>=10 <14": "^14.0.3",
      "basic-ftp@<6.2.1": "^6.2.1",
      "katex@<0.18.2": "^0.19.1"
    }
  }
}
