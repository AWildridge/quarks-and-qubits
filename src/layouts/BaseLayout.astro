---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import cvData from '../data/cv.json';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  schema?: Record<string, unknown>;
}

const SITE_URL = 'https://aj-wildridge.web.cern.ch';
const DEFAULT_OG_IMAGE = `${SITE_URL}/images/og-default.png`;

const {
  title = 'Quarks & Qubits',
  description = 'Research in top-quark physics, quantum computing, and machine learning by AJ Wildridge',
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  author = 'Andrew James Wildridge',
  schema,
} = Astro.props as Props;

const navItems = [
  ['/', 'Home'],
  ['/research/', 'Research'],
  ['/publications/', 'Publications'],
  ['/talks/', 'Talks'],
  ['/cv/', 'CV'],
  ['/contact/', 'Contact'],
];
const currentPath = Astro.url.pathname;
const canonicalURL = new URL(Astro.url.pathname, SITE_URL).href;
function truncate(str: string, max: number) {
  return str.length > max ? `${str.slice(0, max - 1)}…` : str;
}
const rawFullTitle = title === 'Quarks & Qubits' ? title : `${title} | AJ Wildridge`;
const fullTitle = truncate(rawFullTitle, 70);

// Default Person schema for the site owner
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Andrew James Wildridge',
  alternateName: 'AJ Wildridge',
  url: SITE_URL,
  jobTitle: 'Postdoctoral Researcher',
  affiliation: {
    '@type': 'Organization',
    name: 'Fermilab',
  },
  email: cvData.email,
  sameAs: [
    'https://github.com/AWildridge',
    'https://inspirehep.net/authors/1778335',
    'https://orcid.org/0009-0009-2768-4516',
  ],
};

// Website schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Quarks & Qubits',
  description,
  url: SITE_URL,
  author: personSchema,
  inLanguage: 'en-US',
};

// Combine schemas
const structuredData = schema ? [personSchema, schema] : [personSchema, websiteSchema];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline src="/scripts/theme-init.js"></script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Quarks & Qubits RSS Feed"
      href="/rss.xml"
    />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content="Quarks & Qubits" />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && type === 'article' && <meta property="article:author" content={author} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:creator" content="@AWildridge" />

    <!-- Additional SEO -->
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow" />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- Structured Data (JSON-LD) -->
    {
      structuredData.map((schema) => (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
        />
      ))
    }

    <script is:inline src="/scripts/code-copy.js"></script>
    <script is:inline src="/scripts/theme-toggle.js"></script>
  </head>
  <body>
    <a
      href="#main"
      class="skip-link sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 bg-blue-700 text-white px-3 py-2 rounded"
      >Skip to content</a
    >
    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-brand" href="/"
          ><span class="brand-mark" aria-hidden="true">q<span>²</span></span><span
            >Quarks <span class="brand-amp">&amp;</span> Qubits</span
          ></a
        >
        <nav aria-label="Primary" class="site-nav">
          <ul>
            {
              navItems.map(([href, label]) => (
                <li>
                  <a
                    class="nav-link"
                    href={href}
                    aria-current={
                      (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
                        ? 'page'
                        : undefined
                    }
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="flex items-center gap-4">
          <a
            href="/rss.xml"
            class="text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 rounded p-1"
            aria-label="RSS Feed"
            title="Subscribe to RSS feed"
          >
            <span class="sr-only">Subscribe to RSS feed</span>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-3.368c10.58.046 19.152 8.594 19.183 19.188h4.817c-.03-13.231-10.755-23.954-24-24v4.812z"
              ></path>
            </svg>
          </a>
          <div class="inline-flex rounded-md shadow-sm" role="group" aria-label="Theme">
            <button
              type="button"
              data-theme-choice="light"
              class="theme-button rounded-l-md"
              aria-label="Light theme"
              aria-pressed="false"
              title="Light theme"
            >
              <span aria-hidden="true">☀</span>
            </button>
            <button
              type="button"
              data-theme-choice="system"
              class="theme-button border-x-0"
              aria-label="System theme"
              aria-pressed="true"
              title="System theme"
            >
              <span aria-hidden="true">◐</span>
            </button>
            <button
              type="button"
              data-theme-choice="dark"
              class="theme-button rounded-r-md"
              aria-label="Dark theme"
              aria-pressed="false"
              title="Dark theme"
            >
              <span aria-hidden="true">☾</span>
            </button>
          </div>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1" class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <div class="footer-intro">
          <p>Curious about the same questions?</p><a class="text-link" href="/contact/"
            >Let’s talk <span aria-hidden="true">↗</span></a
          >
        </div>
        <span>© {new Date().getFullYear()} AJ Wildridge</span>
        <nav aria-label="Footer" class="mt-3 flex flex-wrap gap-4">
          <a class="underline" href="https://orcid.org/0009-0009-2768-4516">ORCID</a>
          <a class="underline" href="https://inspirehep.net/authors/1778335">INSPIRE-HEP</a>
          <a class="underline" href="https://github.com/AWildridge">GitHub</a>
          <a class="underline" href="/rss.xml">RSS</a>
          <a class="underline" href="/accessibility/">Accessibility</a>
          <a class="underline" href="/privacy/">Privacy</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
