---
import BaseLayout from '../../layouts/BaseLayout.astro';

const modelCardSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Particle Physics Model Card Demo',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  description:
    'Interactive model-card and confusion-matrix viewer for particle-physics classification workflows.',
  author: {
    '@type': 'Person',
    name: 'Andrew James Wildridge',
  },
};
---

<BaseLayout
  title="Model Card Demo"
  description="Interactive model card and confusion matrix viewer for particle-physics classification workflows."
  schema={modelCardSchema}
>
  <h1>Model Card Demo</h1>
  <p class="mt-3 max-w-3xl text-gray-700 dark:text-gray-300">
    Explore how threshold choices change precision, recall, specificity, F1 score, and confusion
    matrix balance for a simplified particle-physics classifier.
  </p>

  <section class="mt-8 grid gap-6 lg:grid-cols-[0.8fr_1.2fr]" aria-labelledby="controls-heading">
    <div>
      <h2 id="controls-heading" class="text-lg font-semibold">Controls</h2>
      <div class="mt-4 space-y-5">
        <label class="block">
          <span class="block text-sm font-medium">Classifier</span>
          <select id="model-select" class="mt-1 w-full rounded border px-3 py-2">
            <option value="baseline">Baseline dense network</option>
            <option value="calibrated">Calibrated transformer</option>
            <option value="conservative">Conservative selection</option>
          </select>
        </label>
        <label class="block">
          <span class="block text-sm font-medium">Decision threshold</span>
          <input
            id="threshold-input"
            class="mt-2 w-full"
            type="range"
            min="20"
            max="80"
            step="5"
            value="50"
          />
          <span id="threshold-value" class="mt-1 block text-sm text-gray-600 dark:text-gray-400"
            >0.50</span
          >
        </label>
      </div>
    </div>

    <div aria-live="polite">
      <h2 class="text-lg font-semibold">Confusion Matrix</h2>
      <div class="mt-4 grid max-w-xl grid-cols-[auto_repeat(2,minmax(7rem,1fr))] gap-2 text-center">
        <div></div>
        <div class="text-sm font-medium">Predicted signal</div>
        <div class="text-sm font-medium">Predicted background</div>
        <div class="flex items-center justify-end text-sm font-medium">True signal</div>
        <div class="matrix-cell" id="tp-cell"></div>
        <div class="matrix-cell" id="fn-cell"></div>
        <div class="flex items-center justify-end text-sm font-medium">True background</div>
        <div class="matrix-cell" id="fp-cell"></div>
        <div class="matrix-cell" id="tn-cell"></div>
      </div>
    </div>
  </section>

  <section class="mt-8" aria-labelledby="metrics-heading">
    <h2 id="metrics-heading" class="text-lg font-semibold">Metrics</h2>
    <dl class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <div class="metric-box">
        <dt>Precision</dt>
        <dd id="precision-value"></dd>
      </div>
      <div class="metric-box">
        <dt>Recall</dt>
        <dd id="recall-value"></dd>
      </div>
      <div class="metric-box">
        <dt>Specificity</dt>
        <dd id="specificity-value"></dd>
      </div>
      <div class="metric-box">
        <dt>F1 Score</dt>
        <dd id="f1-value"></dd>
      </div>
    </dl>
  </section>

  <section class="mt-8" aria-labelledby="card-heading">
    <h2 id="card-heading" class="text-lg font-semibold">Model Card</h2>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div>
        <h3 class="font-medium">Intended Use</h3>
        <p id="intended-use" class="mt-1 text-gray-700 dark:text-gray-300"></p>
      </div>
      <div>
        <h3 class="font-medium">Known Limitations</h3>
        <p id="limitations" class="mt-1 text-gray-700 dark:text-gray-300"></p>
      </div>
    </div>
  </section>

  <script is:inline src="/scripts/model-card-demo.js"></script>
</BaseLayout>
