---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Accessibility" description="Accessibility statement for Quarks & Qubits">
  <h1>Accessibility</h1>
  <p class="mt-3 max-w-3xl text-gray-700 dark:text-gray-300">
    Quarks &amp; Qubits is built as a static, keyboard-operable site with semantic landmarks,
    visible focus states, skip navigation, responsive layouts, and reduced-motion support.
  </p>
  <p class="mt-3 max-w-3xl text-gray-700 dark:text-gray-300">
    The CI accessibility scan runs axe checks across the main pages and fails on any reported
    violation. Issues can be reported through the contact page.
  </p>
</BaseLayout>
