---
import BaseLayout from '../layouts/BaseLayout.astro';
import Card from '../components/Card';
import Tag from '../components/Tag';
import { getCollection } from 'astro:content';
import { publicationDateValue, sortPublicationsByDate } from '../lib/bibtex';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const publications = sortPublicationsByDate(
  (await getCollection('publications')).filter((publication) => !publication.data.draft),
).slice(0, 3);
const talks = (await getCollection('talks'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);

const featuredProjects = projects.slice(0, 3);
const recentItems = [
  ...publications.map((item) => ({
    title: item.data.title,
    href: `/publications/${item.slug}/`,
    meta: `${item.data.year} publication`,
    date: publicationDateValue(item.data),
  })),
  ...talks.map((item) => ({
    title: item.data.title,
    href: '/talks/',
    meta: `${item.data.date.getFullYear()} talk`,
    date: item.data.date.valueOf(),
  })),
]
  .sort((a, b) => b.date - a.date)
  .slice(0, 5);
---

<BaseLayout
  title="Quarks & Qubits"
  description="AJ Wildridge's research site for top-quark physics, quantum information, machine learning, publications, talks, demos, and CV."
>
  <section class="grid gap-8 lg:grid-cols-[1.25fr_0.75fr] lg:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-blue-700 dark:text-blue-300">
        Top-quark physics, quantum information, and machine learning
      </p>
      <h1 class="mt-3 max-w-4xl text-4xl font-semibold leading-tight sm:text-5xl">AJ Wildridge</h1>
      <p class="mt-4 max-w-3xl text-lg text-gray-700 dark:text-gray-300">
        I study collider observables, quantum-inspired reconstruction, and machine-learning methods
        that make high-energy physics measurements more interpretable and reproducible.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a class="button-primary" href="/AJ_Wildridge_CV.pdf" download>Download CV</a>
        <a class="button-secondary" href="https://github.com/AWildridge">GitHub</a>
        <a class="button-secondary" href="https://inspirehep.net/authors/1778335">INSPIRE-HEP</a>
        <a class="button-secondary" href="https://orcid.org/0009-0009-2768-4516">ORCID</a>
      </div>
    </div>
    <div class="rounded-md border border-gray-200 p-5 dark:border-gray-800">
      <h2 class="text-lg font-semibold">Current Focus</h2>
      <dl class="mt-4 space-y-4 text-sm">
        <div>
          <dt class="font-medium">CMS top-quark measurements</dt>
          <dd class="mt-1 text-gray-700 dark:text-gray-300">
            Spin correlations, entanglement observables, and precision event reconstruction.
          </dd>
        </div>
        <div>
          <dt class="font-medium">Quantum-inspired tools</dt>
          <dd class="mt-1 text-gray-700 dark:text-gray-300">
            Annealing and optimization workflows for collider reconstruction problems.
          </dd>
        </div>
        <div>
          <dt class="font-medium">Physics ML</dt>
          <dd class="mt-1 text-gray-700 dark:text-gray-300">
            Foundation models, anomaly detection, and transparent model evaluation.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="research-heading">
    <h2 id="research-heading" class="text-2xl font-semibold">Research Areas</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      <Card title="Top-Quark Spin" href="/research/#top-quark-heading">
        Collider measurements of spin-correlation matrices and quantum observables.
        <div class="mt-3 flex gap-2"><Tag>CMS</Tag><Tag>top quark</Tag></div>
      </Card>
      <Card title="Quantum Computing" href="/research/#quantum-heading">
        Quantum-inspired optimization and annealing approaches for reconstruction tasks.
        <div class="mt-3 flex gap-2"><Tag>annealing</Tag><Tag>optimization</Tag></div>
      </Card>
      <Card title="Machine Learning" href="/research/#ml-heading">
        Model evaluation, anomaly detection challenges, and foundation-model workflows.
        <div class="mt-3 flex gap-2"><Tag>ML</Tag><Tag>model cards</Tag></div>
      </Card>
    </div>
  </section>

  <section class="mt-12" aria-labelledby="featured-projects-heading">
    <div class="flex items-end justify-between gap-4">
      <h2 id="featured-projects-heading" class="text-2xl font-semibold">Featured Projects</h2>
      <a class="underline" href="/projects/">All projects</a>
    </div>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {
        featuredProjects.map((project) => (
          <Card title={project.data.title} href={`/projects/${project.slug}/`}>
            {project.data.summary}
            <div class="mt-3 flex flex-wrap gap-2">
              {project.data.tags.slice(0, 2).map((tag) => (
                <Tag>{tag}</Tag>
              ))}
            </div>
          </Card>
        ))
      }
    </div>
  </section>

  <section class="mt-12" aria-labelledby="recent-heading">
    <h2 id="recent-heading" class="text-2xl font-semibold">Recent</h2>
    <ul class="mt-4 divide-y divide-gray-200 dark:divide-gray-800">
      {
        recentItems.map((item) => (
          <li class="py-3">
            <a
              class="font-medium text-blue-700 hover:underline dark:text-blue-300"
              href={item.href}
            >
              {item.title}
            </a>
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{item.meta}</p>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
