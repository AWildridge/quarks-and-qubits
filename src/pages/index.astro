---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuantumGeometry from '../components/QuantumGeometry.astro';
import OfficialAbstract from '../components/OfficialAbstract.astro';
import { getCollection } from 'astro:content';
import { publicationDateValue, sortPublicationsByDate } from '../lib/bibtex';
const publications = sortPublicationsByDate(
  (await getCollection('publications')).filter((entry) => !entry.data.draft),
);
const talks = (await getCollection('talks')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recent = [
  ...publications.slice(0, 3).map((entry) => ({
    title: entry.data.title,
    href: `/publications/${entry.id}/`,
    kind: 'Publication',
    context: String(entry.data.year),
    date: publicationDateValue(entry.data),
  })),
  ...talks.slice(0, 2).map((entry) => ({
    title: entry.data.title,
    href: `/talks/#${entry.id}`,
    kind: 'Talk',
    context: entry.data.venue || entry.data.event,
    date: entry.data.date.valueOf(),
  })),
]
  .sort((a, b) => b.date - a.date)
  .slice(0, 4);
const areas = [
  {
    number: '01',
    title: 'Particle physics',
    text: 'Top-quark spin, quantum correlations, and the CMS Endcap Timing Layer (ETL) upgrade.',
    href: '/research/#top-quark-heading',
    detail: 'CMS · top quarks · ETL',
  },
  {
    number: '02',
    title: 'Quantum information',
    text: 'Steering ellipsoids, entanglement observables, and measurements of quantum states at colliders.',
    href: '/research/#top-quark-heading',
    detail: 'Entanglement · steering',
  },
  {
    number: '03',
    title: 'Machine learning',
    text: 'Foundation models and interpretable methods that turn complex collision data into physics.',
    href: '/research/#ml-heading',
    detail: 'Reconstruction · discovery',
  },
];
---

<BaseLayout
  title="Quarks & Qubits"
  description="AJ Wildridge explores particle physics, quantum information, and machine learning. Research, publications, talks, and interactive physics tools."
>
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">AJ Wildridge <span class="eyebrow-divider">/</span> Particle physicist</p>
      <h1 id="hero-title">Exploring the <em>quantum side</em> of particle physics.</h1>
      <p class="hero-intro">
        I study what particles can tell us about quantum information—and build the tools to find it
        in collider data.
      </p>
      <p class="hero-affiliation">Postdoctoral researcher · Fermilab · CMS Collaboration</p>
      <div class="hero-actions">
        <a class="button-primary" href="/research/"
          >Explore my research <span aria-hidden="true">↗</span></a
        >
        <a class="text-link" href="/AJ_Wildridge_CV.pdf" download
          >Download CV <span aria-hidden="true">↓</span></a
        >
      </div>
    </div>
    <QuantumGeometry />
  </section>

  <aside class="latest-paper" aria-label="Featured publication">
    <span class="eyebrow">New preprint · 2026</span>
    <a href="/publications/quantum-steering-geometry-at-high-energy-particle-colliders-2026/"
      >Quantum Steering Geometry at High Energy Particle Colliders <span aria-hidden="true">↗</span
      ></a
    >
  </aside>

  <section class="home-section" aria-labelledby="research-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">At the intersection</p><h2 id="research-heading">
          Three fields. Shared questions.
        </h2>
      </div><a class="text-link" href="/research/"
        >Research overview <span aria-hidden="true">↗</span></a
      >
    </div>
    <div class="research-grid">
      {
        areas.map((area) => (
          <a class="research-card" href={area.href}>
            <>
              <span class="research-number">{area.number}</span>
              <h3>{area.title}</h3>
              <p>{area.text}</p>
            </>
            <div class="research-card-footer">
              <>
                <span>{area.detail}</span>
                <span aria-hidden="true">↗</span>
              </>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="home-section" aria-labelledby="recent-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">From the notebook</p><h2 id="recent-heading">
          Recent work &amp; conversations
        </h2>
      </div><a class="text-link" href="/publications/"
        >All publications <span aria-hidden="true">↗</span></a
      >
    </div>
    <ol class="recent-list">
      {
        recent.map((item) => (
          <li>
            <a href={item.href}>
              <>
                <div class="recent-meta">
                  <>
                    <span class="item-kind">{item.kind}</span>
                    <span>{item.context}</span>
                  </>
                </div>
                <h3>
                  <OfficialAbstract text={item.title} inline />
                </h3>
                <span class="recent-arrow" aria-hidden="true">
                  ↗
                </span>
              </>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="explorer-feature" aria-labelledby="explorer-heading">
    <div>
      <p class="eyebrow">Physics you can explore</p><h2 id="explorer-heading">
        Take the correlations<br />for a spin.
      </h2><p>
        Vary the collision energy, choose a spin basis, and explore the geometry of top-quark pairs.
      </p>
    </div>
    <div class="explorer-actions">
      <a class="button-primary" href="/demos/spin-explorer/"
        >Open the Spin Explorer <span aria-hidden="true">↗</span></a
      ><a class="text-link" href="/research/#tools"
        >More research &amp; tools <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>
</BaseLayout>
