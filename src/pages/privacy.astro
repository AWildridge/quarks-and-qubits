---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Privacy" description="Privacy note for Quarks & Qubits">
  <h1>Privacy</h1>
  <p class="mt-3 max-w-3xl text-gray-700 dark:text-gray-300">
    This static site does not use cookies, account tracking, or advertising trackers. Server logs
    may be retained by the hosting provider for operational security and reliability.
  </p>
  <p class="mt-3 max-w-3xl text-gray-700 dark:text-gray-300">
    External links to publishers, repositories, videos, and profile services are governed by those
    services' own privacy policies.
  </p>
</BaseLayout>
